DATABASE_URL=postgres://jobagent:jobagent@localhost:5432/jobagent

# LLM used for job scoring and resume tailoring. All of this (provider, base
# url, keys, models, per-stage overrides below) can also be set from the web
# UI's Settings page instead - it writes to config/settings.json (gitignored),
# which takes effect immediately, no restart. Settings.json wins over these
# env vars when both are set; leave a field blank in Settings to fall back
# here.
# Default: Anthropic (Claude).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional per-stage model override. `score` runs ~40x per cycle (high volume,
# moderate quality bar) - a free open model is usually enough. `tailor` + `prep`
# run on demand per job you like (low volume, quality-sensitive) - worth a
# frontier model. Both fall back to ANTHROPIC_MODEL / LLM_MODEL if unset.
# Example split: cheap score, good tailor.
# SCORE_MODEL=claude-sonnet-4-6
# TAILOR_MODEL=claude-opus-5

# --- Or use an open-weight model instead: set LLM_PROVIDER=openai and job-agent
# speaks the OpenAI-compatible chat/completions shape instead of Anthropic's -
# that covers OpenRouter, Groq, Together, and a self-hosted Ollama/vLLM/
# llama.cpp server. Leave LLM_PROVIDER unset (or "anthropic") to ignore all of
# this and use Claude as above. See DEPLOY.md for a walkthrough of each option.
# LLM_PROVIDER=openai
#
# Groq (free tier, ~1000 req/day, hosts Llama 3.3 70B, Mixtral, and more):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# OpenCode Zen (opencode.ai/auth) - a paid gateway with a handful of genuinely
# free models mixed in (billing details required to get a key even though the
# free models themselves cost $0). Its /v1/chat/completions endpoint is
# OpenAI-compatible, so it's a straight drop-in here. Full free-model list at
# https://opencode.ai/zen/v1/models - "deepseek-v4-flash-free" is the one
# recognizable frontier-lab model in that list; the rest (Big Pickle, Muse
# Spark, Nemotron Lightning/Ultra, Ling, MiMo) are obscure enough that I can't
# vouch for quality - worth a manual test run before trusting them at scale:
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_API_KEY=<your opencode zen key>
# LLM_MODEL=deepseek-v4-flash-free
#
# OpenRouter (free tier is smaller - ~50 req/day - but has the widest model
# choice, including several fully free DeepSeek/Qwen/Llama variants):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=deepseek/deepseek-chat-v3.1:free
#
# Self-hosted Ollama (fully free, fully private, needs your own CPU/GPU;
# `ollama pull llama3.1` then `ollama serve` - no LLM_API_KEY needed):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Optional: Voyage embeddings for the semantic prefilter.
# Leave blank and the pipeline falls back to keyword scoring only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Extra job sources (adapters live in src/adapters/feeds.js).
#
# Adzuna: REQUIRED for Indian-market coverage - it is the only source here that sees
# Naukri/Indeed-tier listings. Free key, ~2 min signup: https://developer.adzuna.com
# "adzuna" is already in feeds[] in config/targets.json; until these are filled in it
# raises a named error once per cycle (ingest prints it) instead of failing quietly.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_QUERY=embedded firmware rtos microcontroller tinyml "edge ai"

# Workday (src/adapters/workday.js) - NXP, Analog Devices, Micron, Cadence, Applied
# Materials and the rest of the embedded employer tier. No key needed. searchText
# filters server-side, so this is the one adapter that narrows before you pay for it;
# keep the query tight. WORKDAY_PAGES x 20 jobs per tenant per cycle, each with a
# JD detail fetch.
WORKDAY_QUERY=embedded firmware
WORKDAY_PAGES=2

# The Muse - OFF by default (not in feeds[]). Measured 0 embedded roles, and note that
# "Engineering" and "IT" are NOT valid category names on its public API (they return 0
# results); only "Science and Engineering" and "Software Engineering" work.
# THEMUSE_API_KEY=
# THEMUSE_CATEGORIES=Science and Engineering,Software Engineering

# Telegram notifications (optional). Create a bot via @BotFather, then
# message it once and read your chat id from getUpdates. These are the FALLBACK:
# Settings -> notifications writes the same two values to config/settings.json and
# those win. There's a "test notification" button there too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Login for the review UI (web/server.js) - a real login page + session
# cookie (web/public/login.html). Leave both blank to run without a login
# prompt (fine for local dev); set both once this is reachable over a tunnel
# or the open internet.
WEB_AUTH_EMAIL=
WEB_AUTH_PASSWORD=

# Which interface docker-compose publishes the review UI on. Blank/unset = 127.0.0.1
# (loopback only - reach it with the SSH tunnel in DEPLOY.md §6). Set 0.0.0.0 to put
# it on the public internet, where WEB_AUTH_* above is the ONLY thing guarding it -
# so set a long password first, and open tcp/3000 in the host firewall + cloud
# security list. Lives here, not in docker-compose.yml, because that file is
# overwritten on every deploy.
WEB_BIND=

# Pipeline tuning
# INGEST_CRON is the FALLBACK schedule for the routine search. Settings -> routine
# search writes schedule_cron to config/settings.json and that wins; changing it there
# reschedules live, with no restart. The "search" button on the review page runs one
# cycle immediately regardless.
INGEST_CRON=0 */3 * * *
PREFILTER_KEEP=40
# Absolute keyword_score below which a job isn't worth an LLM read. Rows above
# the floor but past PREFILTER_KEEP stay queued for the next cycle rather than
# being rejected outright.
PREFILTER_FLOOR=0.35
SCORE_THRESHOLD=0.65
NOTIFY_THRESHOLD=0.75
CONCURRENCY=4
PORT=3000
# Default "posted <Nd ago" filter on the review queue (web/index.html's age
# dropdown overrides this per-session; 0 = no filter).
MAX_AGE_DAYS=1
